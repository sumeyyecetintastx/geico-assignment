# Copy this file to ".env" and adjust if needed.
# ".env" is git-ignored so real values never get committed.

# Application under test
BASE_URL=https://www.saucedemo.com

# All saucedemo.com accounts share the same password
PASSWORD=secret_sauce

# Usernames for each of the saucedemo.com role-based test accounts
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user

# Test execution
# BROWSER: chromium | firefox | webkit | msedge
#   - chromium: Google Chrome's engine (fastest, most common CI default)
#   - firefox:  Mozilla Firefox's engine
#   - webkit:   Apple's WebKit engine (approximates Safari; not literally Safari)
#   - msedge:   real Microsoft Edge (Chromium-based) — run `npm run install:browsers:edge` first
# See README "Browser & headless configuration" for install commands per browser.
BROWSER=chromium
# HEADLESS: true = no visible browser window (faster, what CI uses)
#           false = opens a real, visible browser window so you can watch the
#           test run step by step (useful when writing or debugging tests)
HEADLESS=true
DEFAULT_TIMEOUT=15000
