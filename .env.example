# Copy this file to ".env" and adjust if needed.
# ".env" is git-ignored so real values never get committed.

# Application under test
BASE_URL=https://www.saucedemo.com

# All saucedemo.com accounts share the same password
PASSWORD=secret_sauce

# Usernames for each of the saucedemo.com role-based test accounts
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user

# Test execution
BROWSER=chromium
HEADLESS=true
DEFAULT_TIMEOUT=15000
